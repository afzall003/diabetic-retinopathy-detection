# Point this at the FastAPI backend (see ../api/main.py). Include /api if
# you add that prefix backend-side; the current backend exposes /predict
# directly, so analysisApi.ts's real-mode path accounts for that.
VITE_API_BASE_URL=http://localhost:8001

# true = run entirely on realistic mock data, no backend needed.
# false = call the real FastAPI backend above.
VITE_USE_MOCK_API=true
